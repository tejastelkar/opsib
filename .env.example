# Copy to .env to override defaults. Every setting is prefixed OPSIB_.
OPSIB_DATABASE_URL=postgresql+psycopg://opsib@127.0.0.1:55433/opsib
OPSIB_TENANT_ID=tenant-demo

# Business clock. "frozen" pins it to OPSIB_FROZEN_TIME (the fixture's evaluation time);
# "system" uses the wall clock (what a live deployment would use).
OPSIB_CLOCK_MODE=frozen
OPSIB_FROZEN_TIME=2026-10-16T15:00:00+05:30
OPSIB_BUSINESS_TIMEZONE=Asia/Kolkata

# Rule and routing parameters
OPSIB_SHORTFALL_TOLERANCE_BASE_QTY=0
OPSIB_AVAILABILITY_MAX_AGE_MINUTES=60
OPSIB_TASK_DUE_HOURS=24
OPSIB_MAX_UPLOAD_BYTES=5000000

# Optional advisory AI summaries. "disabled" needs no key and makes no network calls.
# "claude" needs `uv sync --extra ai` and Anthropic credentials in the environment
# (ANTHROPIC_API_KEY or an `ant auth login` profile); keep the key itself out of this file.
OPSIB_AI_PROVIDER=disabled
OPSIB_AI_TIMEOUT_SECONDS=15
OPSIB_ANTHROPIC_MODEL=claude-opus-5-5

OPSIB_LOG_LEVEL=INFO

# Tests use their own database; its name must end in _test (the suite recreates the schema).
TEST_DATABASE_URL=postgresql+psycopg://opsib@127.0.0.1:55433/opsib_test
